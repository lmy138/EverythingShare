# Quick-start host names. These work locally on most modern browsers.
EVERYTHING_HOST=everything.localhost
SHARE_HOST=share.localhost
EDGE_BIND=127.0.0.1
EDGE_PORT=8088

# Use http://share.localhost:8088 for local testing.
# Production must use your externally reachable HTTPS share URL.
PUBLIC_BASE_URL=http://share.localhost:8088
COOKIE_SECURE=false

# Everything HTTP server on the Windows Docker host.
EVERYTHING_BASE_URL=http://host.docker.internal:8081
# Generated by scripts/setup.ps1. Format: Basic + space + Base64(username:password)
EVERYTHING_AUTH_HEADER=Basic REPLACE_WITH_SETUP_SCRIPT

# Generated by scripts/setup.ps1. Never commit the real values.
SESSION_SECRET=REPLACE_WITH_32_BYTE_BASE64URL_SECRET
ADMIN_SHARED_KEY=REPLACE_WITH_RANDOM_ADMIN_SHARED_KEY

TRUST_PROXY_HEADERS=true
TZ=Asia/Shanghai

# ZIP cache controls.
ZIP_CACHE_THRESHOLD_BYTES=5368709120
ZIP_CACHE_MAX_BYTES=53687091200
ZIP_CACHE_TTL_HOURS=24
ZIP_CACHE_MIN_FREE_BYTES=21474836480

# OIDC-only values. scripts/setup.ps1 -AuthMode Oidc fills these in.
OIDC_ISSUER_URL=https://identity.example.com/oidc
OIDC_CLIENT_ID=REPLACE_WITH_OIDC_CLIENT_ID
OIDC_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
OIDC_COOKIE_SECRET=REPLACE_WITH_32_BYTE_BASE64URL_SECRET
OIDC_REDIRECT_URL=https://everything.example.com/oauth2/callback
